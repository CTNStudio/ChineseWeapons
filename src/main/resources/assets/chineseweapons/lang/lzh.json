    "text.chineseweapons.color": "染綺之色：%s",
    "patchouli.chineseweapons.book.entries.armor.suanni_helmet.name": "狻猊兜鍪",
    "patchouli.chineseweapons.book.entries.armor.bohai_helmet.name": "渤海帽",
    "patchouli.chineseweapons.book.entries.armor.bohai_helmet.pages.0.text": "可代明光兜鍪，披全幅明光甲之时，亦引全套甲胄之威能。",
    "patchouli.chineseweapons.book.entries.weapons.tang_dynasty_heng_saber.name": "橫刀",
    "patchouli.chineseweapons.book.entries.weapons.tang_dynasty_heng_saber.pages.0.text": "橫刀者，唐兵也。执而右击，则傷人之数为本器攻伐之力再加二分。",
    "patchouli.chineseweapons.book.entries.weapons.tang_dynasty_heng_saber.pages.1.text": "异效良多，静待增补。",
    "patchouli.chineseweapons.book.entries.weapons.tang_dynasty_horse_armor.name": "唐世馬鎧",
    "patchouli.chineseweapons.book.entries.weapons.tang_dynasty_horse_armor.pages.0.text": "唐馬鎧披於駒馬，可增其捍御之能。",
    "patchouli.chineseweapons.book.entries.weapons.tang_dynasty_horse_armor.pages.1.text": "馬覆此鎧，则箭矢不能傷之。"
}